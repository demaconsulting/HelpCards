<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.HelpCards</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Markdown help and knowledge cards for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/HelpCards</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/HelpCards</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>help;knowledge;markdown;cli</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>HelpCards</Title>
    <Product>HelpCards</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>

    <!-- API Documentation Configuration -->
    <!-- ApiMark turns this project's XML doc comments into gradually-disclosed Markdown API
         reference (api.md index -> namespace -> type -> member) for coding agents and developers.
         - Output defaults to $(MSBuildProjectDirectory)\api (git-ignored, regenerated on every build).
         - Generation runs once per build for the first target framework only, which is correct
           because the public surface is identical across target frameworks.
         - ApiMarkPackDocs ships the generated api/ tree inside the NuGet package.
         - ApiMarkLibraryDescription is the landing text of api.md (before the namespace table): the
           install line, target frameworks, a runnable hello-world and where to start. Keep the
           hello-world compiling when the API changes.
         - ApiMarkEnforceDocs fails the build on any public API member lacking an XML doc summary,
           so the shipped reference cannot silently develop gaps. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
    <ApiMarkLibraryDescription>Markdown help and knowledge cards for .NET: author help as Markdown cards, embed them in assemblies, serve them as command-line help for people and as a searchable knowledge tool for AI agents.

Install: `dotnet add package DemaConsulting.HelpCards` (targets net8.0, net9.0, net10.0 and net11.0).

Hello help, with one in-memory card. A real project keeps its cards in a `Help` folder with a `_source.md` whose `name:` line names the source (every source needs a name), and exposes them with `HelpSource.FromAssembly`.

```csharp
using System;
using System.Collections.Generic;
using DemaConsulting.HelpCards.Catalog;
using DemaConsulting.HelpCards.Loading;

HelpSource source = HelpSource.FromFiles(new Dictionary&lt;string, string&gt;
{
    ["hello.md"] = "---\ntitle: Hello\nsummary: Say hello.\n---\nRun {{tool}} hello.",
}, name: "demo");

HelpCatalog catalog = HelpCatalog.Create(builder => builder.AddSource(source).ToolName("demo"));
Console.WriteLine(catalog.Render(catalog.Find("hello")!));
```

Where to start: write cards and embed them (card format, MSBuild properties): [Loading](DemaConsulting.HelpCards.Loading.md). Add a `help` command to a tool, or expose the cards to an AI agent: [Integration](DemaConsulting.HelpCards.Integration.md). Read, search and render a catalog: [Catalog](DemaConsulting.HelpCards.Catalog.md). Combine several libraries: [Composition](DemaConsulting.HelpCards.Composition.md). Output formats and the JSON contract: [Presentation](DemaConsulting.HelpCards.Presentation.md). Test your cards: [Testing](DemaConsulting.HelpCards.Testing.md).</ApiMarkLibraryDescription>
    <ApiMarkEnforceDocs>Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity>Error</ApiMarkEnforceDocsSeverity>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.HelpCards.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Packaged MSBuild Files: the props and targets that embed help cards in consuming projects
       ship under build\ (not buildTransitive\) so only projects that reference HelpCards directly
       embed cards. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
